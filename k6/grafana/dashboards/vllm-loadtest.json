{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "BRProperty vLLM Load Test",
  "uid": "brproperty-vllm-load",
  "tags": ["vllm", "k6", "load-test"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Virtual Users (k6)",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "k6_vus", "legendFormat": "VUs" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Rate (k6)",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(k6_http_reqs_total[1m]))", "legendFormat": "req/s" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Failed Request Rate (k6)",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "k6_http_req_failed_rate", "legendFormat": "failure rate" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reply Latency p99 (k6)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "k6_http_req_duration_p99", "legendFormat": "p99" },
        { "refId": "B", "expr": "k6_reply_latency_ms_p99", "legendFormat": "reply p99" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "vLLM End-to-End Latency p50 / p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(vllm:e2e_request_latency_seconds_bucket[1m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(vllm:e2e_request_latency_seconds_bucket[1m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "vLLM Running vs Waiting (queue)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "vllm:num_requests_running", "legendFormat": "running" },
        { "refId": "B", "expr": "vllm:num_requests_waiting", "legendFormat": "waiting" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "vLLM KV Cache Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "vllm:kv_cache_usage_perc", "legendFormat": "KV cache" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "vLLM Token Throughput",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(vllm:prompt_tokens_total[1m])", "legendFormat": "prompt tok/s" },
        { "refId": "B", "expr": "rate(vllm:generation_tokens_total[1m])", "legendFormat": "generation tok/s" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "vLLM Time-to-First-Token & Queue Time p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(vllm:time_to_first_token_seconds_bucket[1m])) by (le))", "legendFormat": "TTFT p95" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(vllm:request_queue_time_seconds_bucket[1m])) by (le))", "legendFormat": "queue p95" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "vLLM Prefix Cache Hit Ratio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(vllm:prefix_cache_hits_total[1m]) / clamp_min(rate(vllm:prefix_cache_queries_total[1m]), 0.001)", "legendFormat": "hit ratio" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "vLLM Completed Requests /s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(vllm:request_success_total[1m]))", "legendFormat": "completed/s" }
      ]
    }
  ]
}